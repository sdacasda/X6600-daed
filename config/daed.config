# Candidate OpenWrt configuration overlay, NOT a complete .config.
# Base: ones20250/immortalwrt_ipq 86645e0f52ddffa33677bf79ea34121c1eaefd28
# Apply by replacing existing keys, then run make defconfig and verify results.
# NOT COMPILED. Check final FIT against the 6144 KiB layout and real partition size.
# CI selects the Ubuntu LLVM 18 host toolchain below.

CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_XDP_SOCKETS=y

CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-ikconfig=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_daed-geoip=y
CONFIG_PACKAGE_daed-geosite=y
CONFIG_PACKAGE_luci-app-daed=y

# KERNEL_KPROBE_EVENTS, KERNEL_PERF_EVENTS, FTRACE and DWARVES are resolved
# through source dependencies; verify final Linux .config and host tools.
# Keep the packaged /etc/config/daed enabled=0 for the first boot.

# CI uses Ubuntu 24.04 LLVM 18 instead of rebuilding LLVM.
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH="/usr/lib/llvm-18"
